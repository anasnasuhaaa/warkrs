# Placeholders only. Use .env.local for local configuration.
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/war_krs
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/war_krs
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
EMAIL_MODE=disabled
RESEND_API_KEY=
EMAIL_FROM=War KRS <noreply@example.org>
REALTIME_MODE=polling
TZ=Asia/Jakarta
# Docker Compose reads .env; never commit its values.
POSTGRES_DB=war_krs
POSTGRES_USER=war_krs
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
