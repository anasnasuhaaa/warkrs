{
  "name": "war-krs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/db-check.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "test": "NODE_OPTIONS=--conditions=react-server tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:browser:fixtures": "NODE_OPTIONS=--conditions=react-server tsx scripts/browser-fixtures.ts",
    "test:browser": "playwright test",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "test:load:prepare": "NODE_OPTIONS=--conditions=react-server tsx scripts/load-prepare.ts",
    "test:load": "NODE_OPTIONS=--conditions=react-server tsx scripts/load-run.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.20",
    "@next/env": "^16.4.6",
    "better-auth": "^1.7.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.38.0",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
